    {
      "id": "arriving",
      "title": {
        "en": "Arriving",
        "vi": "Đến nơi"
      },
      "cards": [
        {
          "id": "arrive-first",
          "title": {
            "en": "First hour",
            "vi": "Giờ đầu tiên"
          },
          "summary": {
            "en": "Save your accommodation name, keep your phone charged, and have a simple plan for the first ride.",
            "vi": "Lưu tên chỗ ở, giữ điện thoại có pin và có kế hoạch đơn giản cho chuyến xe đầu."
          },
          "facts": [
            {
              "label": {
                "en": "Remember",
                "vi": "Nhớ"
              },
              "value": {
                "en": "Verify today's airport or border instructions",
                "vi": "Kiểm tra hướng dẫn sân bay hoặc cửa khẩu trong ngày"
              }
            }
          ]
        },
        {
          "id": "arrive-entry",
          "title": {
            "en": "Entry rules",
            "vi": "Quy định nhập cảnh"
          },
          "summary": {
            "en": "Requirements can change. Use current official information before travel.",
            "vi": "Quy định có thể đổi. Dùng thông tin chính thức hiện hành trước chuyến đi."
          },
          "facts": [
            {
              "label": {
                "en": "Rule",
                "vi": "Nguyên tắc"
              },
              "value": {
                "en": "Verify before you fly",
                "vi": "Kiểm tra trước khi bay"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "getting-around",
      "title": {
        "en": "Getting around",
        "vi": "Đi lại"
      },
      "cards": [
        {
          "id": "move-city",
          "title": {
            "en": "Inside cities",
            "vi": "Trong thành phố"
          },
          "summary": {
            "en": "Walk where the streets reward it; use a ride or taxi when heat and traffic make walking a poor choice.",
            "vi": "Đi bộ khi phố phù hợp; dùng xe khi nóng và giao thông khiến đi bộ không hợp."
          },
          "facts": [
            {
              "label": {
                "en": "Rule",
                "vi": "Nguyên tắc"
              },
              "value": {
                "en": "Choose the short safe option",
                "vi": "Chọn phương án ngắn và an toàn"
              }
            }
          ],
          "image": "hanoi-old-quarter"
        },
        {
          "id": "move-between",
          "title": {
            "en": "Between regions",
            "vi": "Giữa các vùng"
          },
          "summary": {
            "en": "Planes, trains, buses and cars each make sense on different legs. Recheck the connection before leaving.",
            "vi": "Máy bay, tàu, xe khách và ô tô hợp với những chặng khác nhau. Kiểm tra lại trước khi đi."
          },
          "facts": [
            {
              "label": {
                "en": "Rule",
                "vi": "Nguyên tắc"
              },
              "value": {
                "en": "Verify the day's service",
                "vi": "Kiểm tra chuyến trong ngày"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "money",
      "title": {
        "en": "Money",
        "vi": "Tiền"
      },
      "cards": [
        {
          "id": "money-basics",
          "title": {
            "en": "Keep it simple",
            "vi": "Giữ đơn giản"
          },
          "summary": {
            "en": "Carry a small amount of cash, keep cards separate, and check the final amount before paying.",
            "vi": "Mang một ít tiền mặt, để thẻ riêng và kiểm tra số tiền cuối trước khi trả."
          },
          "facts": [
            {
              "label": {
                "en": "Rule",
                "vi": "Nguyên tắc"
              },
              "value": {
                "en": "Verify rates and fees locally",
                "vi": "Hỏi tỷ giá và phí tại chỗ"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "accommodation",
      "title": {
        "en": "Accommodation",
        "vi": "Chỗ ở"
      },
      "cards": [
        {
          "id": "stay-choice",
          "title": {
            "en": "Choose by neighbourhood",
            "vi": "Chọn theo khu"
          },
          "summary": {
            "en": "Sleep near the thing you want to do. A central bed can save more effort than a cheaper far bed.",
            "vi": "Ngủ gần thứ bạn muốn làm. Chỗ ở trung tâm có thể đỡ công hơn một nơi rẻ nhưng xa."
          },
          "facts": [
            {
              "label": {
                "en": "Rule",
                "vi": "Nguyên tắc"
              },
              "value": {
                "en": "Read the location, not just the room photo",
                "vi": "Xem vị trí, không chỉ ảnh phòng"
              }
            }
          ]
        }
      ]
    },
