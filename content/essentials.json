        "en": "Accessible travel",
        "vi": "Du lịch tiếp cận"
      },
      "cards": [
        {
          "id": "accessible-plan",
          "title": {
            "en": "Plan the surface",
            "vi": "Tính đến mặt đường"
          },
          "summary": {
            "en": "Historic streets, stairs and uneven paving can make short distances hard. Ask accommodation about entrances before arrival.",
            "vi": "Phố cổ, cầu thang và mặt đường không phẳng có thể làm quãng ngắn trở nên khó. Hỏi chỗ ở về lối vào trước khi đến."
          },
          "image": "hoian",
          "facts": [
            {
              "label": {
                "en": "Rule",
                "vi": "Nguyên tắc"
              },
