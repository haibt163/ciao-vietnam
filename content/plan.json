{
  "title": {
    "en": "Plan",
    "vi": "Lịch trình"
  },
  "lede": {
    "en": "Plan by rhythm, not by collecting places.",
    "vi": "Lên kế hoạch theo nhịp điệu, không phải sưu tầm địa danh."
  },
  "sections": [
    {
      "id": "itineraries",
      "title": {
        "en": "Itineraries",
        "vi": "Lịch trình"
      },
      "intro": {
        "en": "Four starting shapes. Slow down by dropping a stop, not by adding a faster transfer.",
        "vi": "Bốn khung khởi hành. Muốn chậm thì bớt một điểm, không phải thêm chặng nhanh."
      },
      "cards": [
        {
          "id": "route-north-centre",
          "title": {
            "en": "North → centre",
            "vi": "Bắc → miền Trung"
          },
          "image": "catba-cruise",
          "summary": {
            "en": "Hanoi, limestone country, then the old cities. Give the north enough nights instead of racing south.",
            "vi": "Hà Nội, vùng núi đá vôi rồi các đô thị cổ. Hãy dành đủ đêm cho miền Bắc thay vì vội xuống phía Nam."
          },
          "facts": [
            {
              "label": {
                "en": "Good for",
                "vi": "Hợp với"
              },
              "value": {
                "en": "First trip, mixed landscapes, 10–14 days.",
                "vi": "Chuyến đầu tiên, nhiều cảnh quan, 10–14 ngày."
              }
            }
          ]
        },
        {
          "id": "route-heritage",
          "title": {
            "en": "Heritage spine",
            "vi": "Trục di sản"
          },
          "image": "long-bien-sunset",
          "summary": {
            "en": "Hanoi → Ninh Binh → Hue → Hoi An → Ho Chi Minh City. Built for architecture, food and history.",
            "vi": "Hà Nội → Ninh Bình → Huế → Hội An → Thành phố Hồ Chí Minh. Hợp với kiến trúc, ẩm thực và lịch sử."
          },
          "facts": [
            {
              "label": {
                "en": "Good for",
                "vi": "Hợp với"
              },
              "value": {
                "en": "Heritage-focused travellers, 12–16 days.",
                "vi": "Người thích di sản, 12–16 ngày."
              }
            }
          ]
        },
        {
          "id": "route-coast-highlands",
          "title": {
            "en": "Coast + highlands",
            "vi": "Biển + cao nguyên"
          },
          "summary": {
            "en": "Choose one coastal base and one cool highland base. Fewer transfers; more time outside the transport window.",
            "vi": "Chọn một điểm ven biển và một điểm cao nguyên mát. Ít đổi chỗ hơn, có nhiều thời gian tận hưởng hơn."
          },
          "facts": [
            {
              "label": {
                "en": "Good for",
                "vi": "Hợp với"
              },
              "value": {
                "en": "Slower trips, 7–12 days.",
                "vi": "Chuyến đi chậm, 7–12 ngày."
              }
            }
          ],
          "art": "coast-highlands"
        },
        {
          "id": "route-water",
          "title": {
            "en": "Water & islands",
            "vi": "Sông nước & đảo"
          },
          "image": "mekong-boat-2",
          "summary": {
            "en": "Ho Chi Minh City → Mekong Delta → Phu Quoc or Con Dao. Keep water days separate from beach days.",
            "vi": "Thành phố Hồ Chí Minh → Đồng bằng sông Cửu Long → Phú Quốc hoặc Côn Đảo. Tách ngày sông nước khỏi ngày biển."
          },
          "facts": [
            {
              "label": {
                "en": "Good for",
                "vi": "Hợp với"
              },
              "value": {
                "en": "Food, markets and low-key coastal time.",
                "vi": "Ẩm thực, chợ và những ngày ven biển thư thả."
              }
            }
          ]
        }
      ]
    },
